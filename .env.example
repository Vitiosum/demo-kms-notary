# Local run only. On Clever Cloud, set VAULT_ADDR and VAULT_TOKEN with `clever env set`;
# the linked PostgreSQL add-on injects POSTGRESQL_ADDON_URI.
# OpenBao in dev mode stands in for Clever KMS (same Vault API, same Transit routes):
#   bao server -dev -dev-root-token-id=dev-only   then   bao secrets enable transit
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-only
POSTGRESQL_ADDON_URI=postgresql:///notary
# Optional
# KMS_KEY_NAME=notary-master
# TRANSIT_MOUNT=transit
# PG_POOL_MAX=4
PORT=8130
